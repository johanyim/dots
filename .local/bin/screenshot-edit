#!/usr/bin/env bash

area=$(slurp)

if [ $? -ne 0 ]; then
    notify-send "Screenshot cancelled or failed"
    exit 1
fi

name="$(date +'%Y-%m-%d_%H-%M-%S').png"

mkdir -p "$HOME/Pictures"

grim -g "$area" - | swappy -f - -o "$HOME/Pictures/$name"

if [ $? -eq 0 ]; then
    notify-send "Screenshot saved to $name"
else
    notify-send "Screenshot failed"
fi
